{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git tag *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git am *)",
      "PowerShell(git tag *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh release create *)",
      "Read(**/src/environments/environment.ts)",
      "Read(**/src/environments/environment.prod.ts)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/*.p12)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git rm *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npx cap *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore *)",
      "PowerShell(git stash *)",
      "PowerShell(git rm *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npx cap *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-git.js\"",
            "timeout": 10,
            "statusMessage": "Revisando reglas de git del proyecto"
          }
        ]
      }
    ]
  }
}
